# Mellifera MCP Server Configuration

# Required: API URL for your Mellifera backend
MELLIFERA_API_URL=http://localhost:5050

# Required: API key for authentication with Mellifera backend
# Generate this in your Mellifera app settings
MELLIFERA_API_KEY=your_api_key_here

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Port for health check endpoint (if running as HTTP server)
# PORT=3001