# Copy to .env and fill in. The server reads this via dotenv at server/index.js.

# Signing key for the express-session cookie. REQUIRED: the server refuses to
# start without it. There is no default -- the old fallback was 'keyboard cat',
# the express-session README's example string, which is public knowledge.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MongoDB connection string.
ATLAS_URI=

# Checked as a group at the bottom of server/index.js; the process exits if any
# are missing. Used by the voice-processing routes (OpenAI NLU, Amazon Polly).
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Facebook OAuth. Read directly from the environment by server/config/passport.js.
# The Google OAuth credentials and the JWT signing key are NOT read from here --
# they come from server/config/keys.js, which is gitignored.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional. Defaults to 3000. NODE_ENV=production also flips the session and
# auth cookies to Secure.
PORT=3000
NODE_ENV=development
