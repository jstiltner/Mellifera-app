# Mellifera App - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB connection string
# For local: mongodb://localhost:27017/mellifera-dev
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/mellifera
ATLAS_URI=mongodb://localhost:27017/mellifera-dev

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT secret for token signing (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Session secret for express-session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============================================
# AI SERVICES (Optional - Choose One or More)
# ============================================
# The app works fully without AI services configured.
# Configure one or more options below to enable AI features:

# Option 1: AWS Services (for voice features and AWS AI)
# AWS credentials for Polly (text-to-speech) and other AWS services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Option 2: OpenAI API (for AI-powered analysis)
# OpenAI API key for natural language understanding and analysis
OPENAI_API_KEY=

# Option 3: MCP Server (recommended - use your own LLM)
# Connect to a Model Context Protocol server to use your own LLM service
# This allows you to use Claude, GPT-4, local models, etc. without direct API costs
# See MCP_SERVER_GUIDE.md for setup instructions
MCP_SERVER_URL=

# ============================================
# SERVER CONFIGURATION
# ============================================
# Environment mode
NODE_ENV=development

# Server port
PORT=5050

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Set to true to enable debug logging
DEBUG=false

# ============================================
# NOTES
# ============================================
# - Never commit the actual .env file to version control
# - Generate strong random strings for JWT_SECRET and SESSION_SECRET
# - In production, use environment-specific values
#
# AI SERVICES NOTES:
# - All AI services are OPTIONAL - the app works fully without them
# - Basic hive management, inspections, treatments, and feeding work without AI
# - AI services enable enhanced features like:
#   * Automated hive health analysis
#   * Disease detection and treatment recommendations
#   * Voice commands and text-to-speech
#   * Natural language queries
#   * Yield predictions
#
# - MCP Server (recommended): Lets users connect their own LLM service
#   * No API costs for the app owner
#   * Users control their own AI spending
#   * Works with Claude Desktop, GPT-4, local models, etc.
#   * See MCP_SERVER_GUIDE.md for setup
#
# - OpenAI/AWS: Direct integration (costs apply to app owner when users use AI)
#   * Simpler setup for users
#   * Costs incurred by whoever owns the API keys